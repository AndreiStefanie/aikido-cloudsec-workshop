option_settings:
  aws:autoscaling:launchconfiguration:
    RootVolumeType: gp3
  aws:elbv2:listener:443:
    ListenerEnabled: true
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:us-west-1:893596490974:certificate/9f097172-db0d-46ec-9992-fd7aee989519
  aws:elasticbeanstalk:application:environment:
    ADMIN_USERNAME: admin
    WORKSHOP_JOIN_CODE: '169254169254'
  aws:elasticbeanstalk:application:environmentsecrets:
    ADMIN_PASSWORD: arn:aws:ssm:us-west-1:893596490974:parameter/aikido-cloudsec-workshop/admin-password

Resources:
  AWSEBV2LoadBalancerListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn:
        Ref: AWSEBV2LoadBalancer
      Port: 80
      Protocol: HTTP
      DefaultActions:
        - Type: redirect
          RedirectConfig:
            Host: '#{host}'
            Path: '/#{path}'
            Port: '443'
            Protocol: 'HTTPS'
            Query: '#{query}'
            StatusCode: 'HTTP_301'
